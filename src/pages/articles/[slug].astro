---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { C, F, R } from "../../lib/theme.js";
import { SITE, LINKS } from "../../lib/site.js";
import { clip, breadcrumbJsonLd } from "../../lib/seo.js";
import { pad } from "../../components/SkillGrid.jsx";
import { existsSync } from "node:fs";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => !data.draft);
  return articles.map((a) => ({ params: { slug: a.id }, props: { article: a } }));
}
const { article } = Astro.props;
const a = article.data;
const { Content } = await render(article);
const url = `${SITE.url}/articles/${article.id}`;
const img = `/images/articles/${article.id}.png`;
const hasImg = existsSync(`public${img}`);
const fmt = (d: Date) => d.toLocaleDateString("en-AU", { year: "numeric", month: "long", day: "numeric", timeZone: "Australia/Melbourne" });

const allArticles = await getCollection("articles", ({ data }) => !data.draft);
const related = allArticles
  .filter((x) => x.id !== article.id && x.data.kind !== "hub" && x.data.tags.some((t) => a.tags.includes(t)))
  .sort((x, y) => +y.data.date - +x.data.date).slice(0, 3);
const skills = (await getCollection("skills")).map((s) => s.data).filter((s) => a.skills.includes(s.number)).sort((x, y) => x.number - y.number);

const authors = [{ "@type": "Person", name: a.author }, ...(a.coauthor ? [{ "@type": "Person", name: a.coauthor }] : [])];
const ld = {
  "@context": "https://schema.org", "@type": "BlogPosting",
  headline: a.title, description: clip(a.excerpt),
  datePublished: a.date.toISOString().slice(0, 10), dateModified: (a.updated || a.date).toISOString().slice(0, 10),
  author: authors.length === 1 ? authors[0] : authors,
  keywords: a.tags.join(", "),
  ...(hasImg ? { image: SITE.url + img } : {}),
  mainEntityOfPage: a.canonical || url,
  publisher: { "@type": "Organization", name: SITE.legalName, url: SITE.url, logo: { "@type": "ImageObject", url: `${SITE.url}/images/logo-exlcloud500.png` } },
};
---
<BaseLayout title={`${a.title} | EXL Cloud Articles`} description={clip(a.excerpt)} canonical={a.canonical} ogType="article" ogImage={hasImg ? img : undefined}
  jsonLd={[ld, breadcrumbJsonLd([["Home", "/"], ["Articles", "/articles"], [a.title, `/articles/${article.id}`]])]}>
  <section style={{ background: `linear-gradient(170deg, ${C.dark}, ${C.pri})`, padding: "80px 24px 50px" }}>
    <div style={{ maxWidth: "800px", margin: "0 auto" }}>
      <a href="/articles" style={{ fontFamily: F, fontSize: "14px", color: C.mint, display: "inline-flex", alignItems: "center", gap: "8px", marginBottom: "28px" }}>← Back to Articles</a>
      <div style={{ display: "flex", gap: "8px", flexWrap: "wrap", marginBottom: "16px" }}>
        {a.tags.map((t) => <span style={{ fontFamily: F, fontSize: "11px", fontWeight: 600, color: C.mint, padding: "4px 12px", borderRadius: `${R.full}px`, background: "rgba(116,198,157,0.15)" }}>{t}</span>)}
      </div>
      <h1 style={{ fontFamily: F, fontSize: "40px", fontWeight: 800, color: C.w, lineHeight: 1.15, margin: "0 0 20px" }}>{a.title}</h1>
      <div style={{ fontFamily: F, fontSize: "15px", fontWeight: 600, color: C.w }}>{a.author}{a.coauthor ? ` & ${a.coauthor}` : ""}</div>
      <div style={{ fontFamily: F, fontSize: "13px", color: "rgba(255,255,255,0.5)" }}><time datetime={a.date.toISOString().slice(0, 10)}>{fmt(a.date)}</time></div>
    </div>
  </section>
  <section style={{ padding: "60px 24px 80px" }}>
    <article style={{ maxWidth: "800px", margin: "0 auto" }}>
      {a.originalUrl && (
        <p style={{ fontFamily: F, fontSize: "14px", color: C.gD, background: C.warmBg, border: `1px solid ${C.gL}`, borderRadius: `${R.sm}px`, padding: "12px 16px", margin: "0 0 28px" }}>
          Originally published on the <a href={a.originalUrl} target="_blank" rel="noopener" style={{ color: C.priL, textDecoration: "underline" }}>Model Citizn Knowledge Hub ↗</a>
        </p>
      )}
      <div style={{ background: C.pale, borderLeft: `4px solid ${C.priA}`, borderRadius: "0 12px 12px 0", padding: "20px 24px", marginBottom: "36px" }}>
        <div style={{ fontFamily: F, fontSize: "11px", fontWeight: 700, color: C.priA, letterSpacing: "2px", marginBottom: "6px", textTransform: "uppercase" }}>Key Takeaway</div>
        <p style={{ fontFamily: F, fontSize: "15px", color: C.gD, lineHeight: 1.7, margin: 0 }}>{a.excerpt}</p>
      </div>
      <div class="article-body"><Content /></div>
      {skills.length > 0 && (
        <aside style={{ marginTop: "40px", borderTop: `1px solid ${C.gL}`, paddingTop: "28px" }}>
          <h2 style={{ fontFamily: F, fontSize: "18px", fontWeight: 800, color: C.dark, margin: "0 0 14px" }}>Skills in this article</h2>
          <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(220px, 1fr))", gap: "12px" }}>
            {skills.map((s) => (
              <a href={`/skills/${s.slug}`} class="lift" style={{ display: "block", background: C.warmBg, border: `1px solid ${C.gL}`, borderRadius: `${R.md}px`, padding: "14px 16px" }}>
                <span style={{ fontFamily: F, fontSize: "11px", fontWeight: 700, color: C.priA }}>SKILL {pad(s.number)}</span>
                <div style={{ fontFamily: F, fontSize: "15px", fontWeight: 700, color: C.dark, marginTop: "4px" }}>{s.name}</div>
              </a>
            ))}
          </div>
        </aside>
      )}
    </article>
  </section>
  {related.length > 0 && (
    <section style={{ background: C.warmBg, padding: "80px 24px" }}>
      <div style={{ maxWidth: "1120px", margin: "0 auto" }}>
        <h2 style={{ fontFamily: F, fontSize: "28px", fontWeight: 800, color: C.dark, margin: "0 0 28px" }}>More articles you might enjoy</h2>
        <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fill, minmax(300px, 1fr))", gap: "24px" }}>
          {related.map((r) => (
            <a href={`/articles/${r.id}`} class="lift" style={{ display: "block", background: C.w, borderRadius: `${R.xl}px`, border: `1px solid ${C.gL}`, padding: "24px" }}>
              <h3 style={{ fontFamily: F, fontSize: "17px", fontWeight: 700, color: C.dark, margin: "0 0 8px", lineHeight: 1.3 }}>{r.data.title}</h3>
              <div style={{ fontFamily: F, fontSize: "12px", color: C.g }}>{r.data.author} · {fmt(r.data.date)}</div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
  <section style={{ padding: "80px 24px" }}>
    <div style={{ maxWidth: "1120px", margin: "0 auto", background: `linear-gradient(135deg, ${C.pri}, ${C.priL})`, borderRadius: `${R.xl}px`, padding: "48px", textAlign: "center" }}>
      <h2 style={{ fontFamily: F, fontSize: "24px", fontWeight: 700, color: C.w, margin: "0 0 14px" }}>Put these insights into practice</h2>
      <p style={{ fontFamily: F, fontSize: "15px", color: "rgba(255,255,255,0.65)", margin: "0 auto 28px", maxWidth: "480px", lineHeight: 1.65 }}>EXL Cloud gives you the financial models, reports and AI skills discussed here — directly in Excel, connected to Xero.</p>
      <a href={LINKS.checkout} target="_blank" rel="noopener noreferrer" class="cta-btn">Start Free Trial</a>
    </div>
  </section>
</BaseLayout>
