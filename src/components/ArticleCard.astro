---
import { C, F, R } from "../lib/theme.js";
import { existsSync } from "node:fs";
interface Props { article: any; }
const { article } = Astro.props;
const a = article.data;
const img = `/images/articles/${article.id}.png`;
const hasImg = existsSync(`public${img}`);
const fmt = (d: Date) => d.toLocaleDateString("en-AU", { year: "numeric", month: "long", day: "numeric", timeZone: "Australia/Melbourne" });
---
<a href={`/articles/${article.id}`} class="lift article-card" data-tags={a.tags.join("|")}
  style={{ background: C.w, borderRadius: `${R.xl}px`, overflow: "hidden", border: `1px solid ${C.gL}`, color: "inherit", display: "flex", flexDirection: "column" }}>
  <div style={{ width: "100%", aspectRatio: "1200/630", background: "linear-gradient(135deg, #1A3C2E, #0F1F17)" }}>
    {hasImg && <img src={img} alt="" loading="lazy" width="1200" height="630" style={{ width: "100%", height: "100%", objectFit: "cover" }} />}
  </div>
  <div style={{ padding: "24px 24px 28px", flex: "1", display: "flex", flexDirection: "column" }}>
    <div style={{ display: "flex", gap: "6px", flexWrap: "wrap", marginBottom: "12px" }}>
      {a.tags.map((t: string) => <span style={{ fontFamily: F, fontSize: "10px", fontWeight: 600, color: C.priA, letterSpacing: "0.5px", padding: "3px 10px", borderRadius: `${R.full}px`, background: C.pale }}>{t}</span>)}
    </div>
    <h3 style={{ fontFamily: F, fontSize: "18px", fontWeight: 700, color: C.dark, margin: "0 0 10px", lineHeight: 1.3 }}>{a.title}</h3>
    <p style={{ fontFamily: F, fontSize: "14px", color: C.g, lineHeight: 1.65, margin: "0 0 16px", flex: "1" }}>{a.excerpt.length > 160 ? a.excerpt.slice(0, 157).replace(/\s+\S*$/, "") + "…" : a.excerpt}</p>
    <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", paddingTop: "14px", borderTop: `1px solid ${C.gL}`, gap: "8px" }}>
      <span style={{ fontFamily: F, fontSize: "12px", color: C.g }}>{a.author}{a.coauthor ? ` & ${a.coauthor}` : ""}</span>
      <span style={{ fontFamily: F, fontSize: "12px", color: C.g, whiteSpace: "nowrap" }}>{fmt(a.date)}</span>
    </div>
  </div>
</a>
